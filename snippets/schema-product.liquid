{%- comment -%}
  Product structured data (JSON-LD) for rich results (price, availability, brand).
  Uses the `| json` filter so all strings are safely escaped.
  Accepts: product (defaults to the page product).
{%- endcomment -%}
{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
-%}
{%- if p != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ p.title | json }},
  "url": {{ request.origin | append: p.url | json }},
  {%- if p.description != blank %}
  "description": {{ p.description | strip_html | truncate: 320 | json }},
  {%- endif %}
  {%- if p.images.size > 0 %}
  "image": [
    {%- for image in p.images limit: 6 -%}
    {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  ],
  {%- endif %}
  {%- if v.sku != blank %}
  "sku": {{ v.sku | json }},
  {%- endif %}
  {%- if p.vendor != blank %}
  "brand": {
    "@type": "Brand",
    "name": {{ p.vendor | json }}
  },
  {%- endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: p.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ v.price | money_without_currency | replace: ',', '' }}",
    "availability": "https://schema.org/{% if p.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>
{%- endif -%}
