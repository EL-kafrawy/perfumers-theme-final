{%- comment -%}
  Renders a product card.
  Accepts:
  - product: {Product} Product Liquid object
  - badge: {String} 'sale', 'new', 'best_seller' (optional)
{%- endcomment -%}

{%- comment -%}
  `available` is true when any variant is in stock, so a card is only marked
  sold out when the whole product is unbuyable.
{%- endcomment -%}
{%- assign is_sold_out = false -%}
{%- unless product.available -%}{%- assign is_sold_out = true -%}{%- endunless -%}

{%- comment -%}
  Discount. Shopify has no "percent off" field, so it's derived from the
  compare-at price. Rounded, because "-33%" reads and scans far faster than
  a price pair the customer has to subtract themselves.
{%- endcomment -%}
{%- assign has_discount = false -%}
{%- assign discount_pct = 0 -%}
{%- if product.compare_at_price > product.price and product.compare_at_price > 0 -%}
  {%- assign has_discount = true -%}
  {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
{%- endif -%}

<div class="product-card{% if is_sold_out %} product-card--sold-out{% endif %}">
  {%- comment -%}
    No aria-label here on purpose. The link already contains the brand, title,
    price and any Sold Out badge; an aria-label would REPLACE all of that as the
    accessible name, so a screen reader would hear only the title and lose the
    price. It also made text extraction read the title twice ("Turthi
    ElectricTurthi Electric"), since the label and the heading both surface.
  {%- endcomment -%}
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__image-wrapper">
      {%- if product.featured_image -%}
        <img 
          src="{{ product.featured_image | image_url: width: 400, format: 'webp' }}"
          srcset="{{ product.featured_image | image_url: width: 400, format: 'webp' }} 1x, {{ product.featured_image | image_url: width: 600, format: 'webp' }} 1.5x"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="product-card__image"
          width="400"
          height="533"
          loading="lazy">
        {%- if product.images[1] -%}
          <img 
            src="{{ product.images[1] | image_url: width: 400, format: 'webp' }}"
            srcset="{{ product.images[1] | image_url: width: 400, format: 'webp' }} 1x, {{ product.images[1] | image_url: width: 600, format: 'webp' }} 1.5x"
            alt="{{ product.images[1].alt | escape }}"
            class="product-card__image product-card__image--hover"
            width="400"
            height="533"
            loading="lazy">
        {%- endif -%}
      {%- else -%}
        <div class="product-card__image placeholder-image" style="aspect-ratio:3/4;">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}

      {%- comment -%} Sold out outranks Sale/New — it's the fact that changes the decision. {%- endcomment -%}
      {%- if is_sold_out -%}
        <span class="product-card__badge product-card__badge--sold-out">{{ 'actions.sold_out' | t }}</span>
      {%- elsif has_discount -%}
        <span class="product-card__badge product-card__badge--sale">−{{ discount_pct }}%</span>
      {%- elsif badge == 'sale' -%}
        <span class="product-card__badge product-card__badge--sale">{{ 'product.sale' | t }}</span>
      {%- elsif badge == 'new' -%}
        <span class="product-card__badge product-card__badge--new">{{ 'product.new' | t }}</span>
      {%- elsif badge == 'best_seller' -%}
        <span class="product-card__badge product-card__badge--new">{{ 'product.best_seller' | t }}</span>
      {%- endif -%}

    </div>

    <div class="product-card__info">
      <p class="product-card__brand">{{ product.vendor }}</p>
      <h3 class="product-card__title">{{ product.title }}</h3>
      <div class="product-card__price-wrapper">
        {%- comment -%} Sale price leads; the old price follows, struck through. {%- endcomment -%}
        <span class="product-card__price{% if has_discount %} product-card__price--sale{% endif %}">
          {% render 'price', price: product.price %}
        </span>
        {%- if has_discount -%}
          <span class="product-card__price--compare">
            {% render 'price', price: product.compare_at_price %}
          </span>
        {%- endif -%}
      </div>
    </div>
  </a>
</div>

<style>
  .product-card {
    position: relative;
    overflow: hidden;
    /* Fill the grid cell so every card in a row is the same height */
    height: 100%;
    display: flex;
  }
  .product-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .product-card__info {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }
  /* Push price to the bottom so prices align across cards */
  .product-card__price-wrapper {
    margin-top: auto;
  }
  .product-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  .product-card:hover .product-card__image--hover {
    opacity: 1;
  }

  .product-card__link {
    color: inherit;
    text-decoration: none;
  }
  .product-card__info {
    padding-top: 10px;
  }
  .product-card__price-wrapper {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .product-card__image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-pearl, #E7DDD4);
  }
  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base, 300ms ease);
  }
  .product-card:hover .product-card__image:not(.product-card__image--hover) {
    transform: scale(1.03);
  }
  .product-card__image--hover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card__brand {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gold, #C8A46A);
    margin: 0 0 3px;
    /* Keep brand to a single line so cards stay uniform */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .product-card__title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-charcoal, #2E2A33);
    margin: 0 0 4px;
    line-height: 1.3;
    /* Clamp to 2 lines and reserve the height so every card's price aligns */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.4em;
  }
  .product-card__price {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-taupe, #7E6C5F);
  }
  .product-card__price--sale {
    color: var(--color-gold, #C8A46A);
    font-weight: 600;
  }
  .product-card__price--compare {
    font-size: 0.7rem;
    color: var(--color-taupe, #7E6C5F);
    opacity: 0.6;
    text-decoration: line-through;
  }

  /* --- Badges ------------------------------------------------------
     The image wrapper is overflow:hidden and the image fills it, so a
     badge has to be taken out of flow or it gets clipped away. */
  .product-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
    padding: 6px 10px;
    border-radius: 2px;
    background: var(--color-charcoal, #2E2A33);
    color: var(--color-ivory, #F5F1EB);
    pointer-events: none;
  }
  .product-card__badge--sale {
    background: var(--color-gold, #C8A46A);
    color: var(--color-ivory, #F5F1EB);
  }
  .product-card__badge--new {
    background: var(--color-charcoal, #2E2A33);
    color: var(--color-ivory, #F5F1EB);
  }

  /* --- Sold out ----------------------------------------------------
     Read as unavailable at a glance: the image drains of colour and the
     badge sits centred rather than in the corner, so it isn't mistaken
     for a promo tag. */
  .product-card__badge--sold-out {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(46, 42, 51, 0.82);
    color: #FFFFFF;
    padding: 8px 16px;
    letter-spacing: 0.18em;
    backdrop-filter: blur(2px);
  }
  .product-card--sold-out .product-card__image {
    filter: grayscale(100%);
    opacity: 0.62;
  }
  /* No lift or image swap on a card you can't buy from. */
  .product-card--sold-out:hover .product-card__image:not(.product-card__image--hover) {
    transform: none;
  }
  .product-card--sold-out:hover .product-card__image--hover {
    opacity: 0;
  }
  .product-card--sold-out .product-card__title,
  .product-card--sold-out .product-card__price {
    color: var(--color-taupe, #7E6C5F);
  }
  .product-card--sold-out .product-card__price {
    text-decoration: line-through;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__image { transition: none; }
  }

</style>
