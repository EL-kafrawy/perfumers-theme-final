<section class="product-gallery section--flush" data-section-id="{{ section.id }}">
  <div class="product-gallery__wrapper" data-product-gallery>
    <!-- Main Image -->
    <div class="product-gallery__main">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="product-gallery__main-image"
          data-product-main-image
          width="800"
          height="1067"
          loading="eager"
        >
      {%- else -%}
        <div class="product-gallery__main-image placeholder-image" style="aspect-ratio:1/1;">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}

      {%- comment -%}
        Sold out outranks Sale here for the same reason it does on the card:
        the price is irrelevant if the bottle can't be bought.
      {%- endcomment -%}
      {%- if product.available == false -%}
        <span class="product-gallery__badge product-gallery__badge--sold-out">{{ 'actions.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="product-gallery__badge product-gallery__badge--sale">{{ 'product.sale' | t }}</span>
      {%- endif -%}
    </div>

    <!-- Thumbnails -->
    {%- if product.images.size > 1 -%}
      <div class="product-gallery__thumbs scroll-row">
        {%- for image in product.images -%}
          <button
            class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-product-thumbnail
            data-full-src="{{ image | image_url: width: 800 }}"
            aria-label="View image {{ forloop.index }}"
          >
            <img
              src="{{ image | image_url: width: 120 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="80"
              height="100"
            >
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  /* ---- Gallery Component ---- */
  .product-gallery__wrapper {
    background: var(--color-surface);
  }
  .product-gallery__main {
    position: relative;
    overflow: hidden;
  }
  .product-gallery__main-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    max-height: 70vh;
  }
  /* Mobile: smaller, centered product image so Add to Cart sits higher on screen */
  @media (max-width: 767px) {
    .product-gallery__main-image {
      aspect-ratio: 1 / 1;
      max-height: 44vh;
      width: auto;
      max-width: 100%;
      margin: 0 auto;
    }
  }
  @media (min-width: 1024px) {
    .product-gallery__main-image {
      max-height: calc(100vh - 180px);
    }
  }
  /* ---- Badges ----
     These used to reuse .product-card__badge, whose CSS only reaches the page
     when a product card happens to render on it. Own them here instead. */
  .product-gallery__badge {
    position: absolute;
    top: var(--space-md, 16px);
    left: var(--space-md, 16px);
    z-index: 2;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
    padding: 7px 12px;
    border-radius: 2px;
    background: var(--color-gold, #C8A46A);
    color: var(--color-ivory, #F5F1EB);
    pointer-events: none;
  }
  /* Centred and neutral, matching the product card, so it reads as a state
     rather than a promotion. */
  .product-gallery__badge--sold-out {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(46, 42, 51, 0.82);
    color: #FFFFFF;
    padding: 10px 20px;
    letter-spacing: 0.18em;
    backdrop-filter: blur(2px);
  }
  .product-gallery__main:has(.product-gallery__badge--sold-out) .product-gallery__main-image {
    filter: grayscale(100%);
    opacity: 0.72;
  }

  .product-gallery__thumbs {
    padding: var(--space-md);
    gap: var(--space-sm);
  }
  .product-gallery__thumb {
    flex: 0 0 64px;
    width: 64px;
    height: 80px;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    background: none;
    padding: 0;
    transition: border-color var(--transition-fast);
  }
  .product-gallery__thumb.is-active {
    border-color: var(--color-gold);
  }
  .product-gallery__thumb:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
    border-color: var(--color-gold);
  }
  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Desktop: gallery wrapper switches to vertical thumb strip */
  @media (min-width: 1024px) {
    .product-gallery .product-gallery__wrapper {
      display: flex;
      flex-direction: row-reverse;
      gap: var(--space-md);
    }
    .product-gallery__main { flex: 1; }
    .product-gallery__thumbs {
      flex-direction: column;
      overflow-y: auto;
      overflow-x: hidden;
      max-height: 600px;
      width: 80px;
    }
    .product-gallery__thumb { flex: 0 0 80px; width: 80px; height: 100px; }
  }
</style>

{% schema %}
{
  "name": "Product Gallery",
  "settings": [],
  "presets": [
    {
      "name": "Product Gallery"
    }
  ]
}
{% endschema %}
