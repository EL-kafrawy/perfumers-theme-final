<div class="product-sticky-bar" id="sticky-atc" data-sticky-bar data-section-id="{{ section.id }}">
  <div class="product-sticky-bar__inner">
    <div class="product-sticky-bar__info">
      <span class="product-sticky-bar__label">Total</span>
      <span class="product-sticky-bar__price" data-product-price>{% render 'price', price: product.price %}</span>
    </div>
    <button
      class="product-sticky-bar__btn"
      onclick="document.querySelector('[data-add-to-cart]') ? document.querySelector('[data-add-to-cart]').click() : (document.querySelector('[name=add]') && document.querySelector('[name=add]').click())"
      {% unless product.available %}disabled{% endunless %}
    >
      {%- if product.available -%}
        {{ 'actions.add_to_cart' | t }}
      {%- else -%}
        {{ 'actions.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>
</div>

<style>
  .product-sticky-bar {
    position: fixed;
    bottom: -90px;
    left: 0;
    right: 0;
    z-index: 8888;
    background: rgba(245, 241, 235, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(200, 164, 106, 0.2);
    box-shadow: 0 -10px 30px rgba(0,0,0,0.05);
    padding: 14px 20px;
    transition: bottom 0.3s ease;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
  }
  .product-sticky-bar.visible,
  .product-sticky-bar.is-visible { bottom: 0; }

  .product-sticky-bar__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 768px;
    margin: 0 auto;
  }
  .product-sticky-bar__info {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }
  .product-sticky-bar__label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    opacity: 0.5;
    color: var(--color-charcoal, #2E2A33);
  }
  .product-sticky-bar__price {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-charcoal, #2E2A33);
  }
  .product-sticky-bar__btn {
    flex: 1;
    background: var(--color-gold, #C8A46A);
    color: #fff;
    border: none;
    border-radius: 2px;
    padding: 15px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .product-sticky-bar__btn:hover { opacity: 0.92; }
  .product-sticky-bar__btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
  (function(){
    var mainBtn = document.querySelector('[data-add-to-cart], [name=add], .product-form__submit');
    var stickyBar = document.getElementById('sticky-atc');
    if (!mainBtn || !stickyBar) return;
    var observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        stickyBar.classList.toggle('visible', !entry.isIntersecting);
      });
    }, { threshold: 0.1 });
    observer.observe(mainBtn);
  })();
</script>

{% schema %}
{
  "name": "Product Sticky Bar",
  "settings": [],
  "presets": [
    {
      "name": "Product Sticky Bar"
    }
  ]
}
{% endschema %}
