<section class="product-info section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="product-info__wrapper">
      <!-- Product JSON Data (required by product-page.js) -->
      <script type="application/json" data-product-json>{{ product | json }}</script>

      <!-- Accent / Collection -->
      <p class="pdp__accent">
        {%- if section.settings.accent_text != blank -%}{{ section.settings.accent_text }}{%- else -%}{{ product.vendor }}{%- endif -%}
      </p>

      <!-- Title -->
      <h1 class="pdp__title">{{ product.title }}</h1>

      <!-- Price -->
      <div class="pdp__price-row">
        <span class="pdp__price" data-product-price>{% render 'price', price: product.price %}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="pdp__compare" data-product-compare-price>{% render 'price', price: product.compare_at_price %}</span>
          {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          <span class="pdp__savings">-{{ savings }}%</span>
        {%- endif -%}
      </div>

      <!-- Product Form -->
      {%- form 'product', product, data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <!-- Volume / Variant Selection (shown only for multi-variant products) -->
        {%- if product.variants.size > 1 -%}
          <div class="pdp__variants">
            <label class="pdp__label">{{ 'product.select_volume' | t }}</label>
            <div class="pdp__volume-options">
              {%- for variant in product.variants -%}
                <button
                  type="button"
                  class="pdp__volume-btn{% if variant == product.selected_or_first_available_variant %} is-active{% endif %}{% unless variant.available %} is-sold-out{% endunless %}"
                  data-volume-option
                  data-variant-id="{{ variant.id }}"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Quantity + Actions -->
        <div class="pdp__actions">
          <div class="pdp__qty">
            <button type="button" class="pdp__qty-btn" data-product-qty-minus aria-label="Decrease quantity">
              <span class="material-symbols-outlined">remove</span>
            </button>
            <input type="number" class="pdp__qty-input" data-product-qty name="quantity" value="1" min="1" max="99" aria-label="{{ 'product.quantity' | t }}">
            <button type="button" class="pdp__qty-btn" data-product-qty-plus aria-label="Increase quantity">
              <span class="material-symbols-outlined">add</span>
            </button>
          </div>

          <button
            type="submit"
            class="pdp__btn pdp__btn--add"
            data-add-to-cart
            {% unless product.available %}disabled{% endunless %}
          >
            <span data-add-to-cart-text data-add-text="{{ 'actions.add_to_cart' | t }}" data-sold-out-text="{{ 'actions.sold_out' | t }}">
              {%- if product.available -%}{{ 'actions.add_to_cart' | t }}{%- else -%}{{ 'actions.sold_out' | t }}{%- endif -%}
            </span>
          </button>

          {%- if section.settings.show_buy_now -%}
            <button type="submit" class="pdp__btn pdp__btn--buy" data-buy-now>
              {{ 'actions.buy_now' | t }}
            </button>
          {%- endif -%}
        </div>
      {%- endform -%}

      <!-- The Essence -->
      {%- assign essence = product.metafields.custom.short_description -%}
      {%- if essence == blank -%}{%- assign essence = section.settings.essence_default -%}{%- endif -%}
      {%- if essence != blank -%}
        <div class="pdp__block">
          <h3 class="pdp__essence-title">{{ section.settings.essence_heading | default: 'The Essence' }}</h3>
          <p class="pdp__essence">{{ essence }}</p>
        </div>
      {%- endif -%}

      <!-- Family / Occasion / Sillage -->
      {%- if section.settings.attr_family != blank or section.settings.attr_occasion != blank or section.settings.attr_sillage != blank -%}
        <div class="pdp__attrs">
          {%- if section.settings.attr_family != blank -%}
            <div class="pdp__attr">
              <p class="pdp__attr-label">{{ section.settings.attr_family_label | default: 'Family' }}</p>
              <p class="pdp__attr-value">{{ section.settings.attr_family }}</p>
            </div>
          {%- endif -%}
          {%- if section.settings.attr_occasion != blank -%}
            <div class="pdp__attr">
              <p class="pdp__attr-label">{{ section.settings.attr_occasion_label | default: 'Occasion' }}</p>
              <p class="pdp__attr-value">{{ section.settings.attr_occasion }}</p>
            </div>
          {%- endif -%}
          {%- if section.settings.attr_sillage != blank -%}
            <div class="pdp__attr">
              <p class="pdp__attr-label">{{ section.settings.attr_sillage_label | default: 'Sillage' }}</p>
              <p class="pdp__attr-value">{{ section.settings.attr_sillage }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Fragrance Notes -->
      {%- if section.settings.notes_top != blank or section.settings.notes_heart != blank or section.settings.notes_base != blank -%}
        <div class="pdp__block">
          <h3 class="pdp__notes-title">{{ section.settings.notes_heading | default: 'Fragrance Notes' }}</h3>
          <div class="pdp__notes">
            {%- if section.settings.notes_top != blank -%}
              <div class="pdp__note">
                <div class="pdp__note-icon"><span class="material-symbols-outlined">eco</span></div>
                <div><p class="pdp__note-level">Top</p><p class="pdp__note-value">{{ section.settings.notes_top }}</p></div>
              </div>
            {%- endif -%}
            {%- if section.settings.notes_heart != blank -%}
              <div class="pdp__note">
                <div class="pdp__note-icon"><span class="material-symbols-outlined">local_florist</span></div>
                <div><p class="pdp__note-level">Heart</p><p class="pdp__note-value">{{ section.settings.notes_heart }}</p></div>
              </div>
            {%- endif -%}
            {%- if section.settings.notes_base != blank -%}
              <div class="pdp__note">
                <div class="pdp__note-icon"><span class="material-symbols-outlined">forest</span></div>
                <div><p class="pdp__note-level">Base</p><p class="pdp__note-value">{{ section.settings.notes_base }}</p></div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <!-- Accordions -->
      <div class="pdp__accordions">
        {%- if section.settings.delivery_text != blank -%}
          <details class="pdp__acc">
            <summary class="pdp__acc-head"><span>{{ 'product.delivery' | t }}</span><span class="material-symbols-outlined pdp__acc-icon">expand_more</span></summary>
            <div class="pdp__acc-body">{{ section.settings.delivery_text }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.returns_text != blank -%}
          <details class="pdp__acc">
            <summary class="pdp__acc-head"><span>{{ 'product.returns' | t }}</span><span class="material-symbols-outlined pdp__acc-icon">expand_more</span></summary>
            <div class="pdp__acc-body">{{ section.settings.returns_text }}</div>
          </details>
        {%- endif -%}
        {%- if product.description != blank -%}
          <details class="pdp__acc">
            <summary class="pdp__acc-head"><span>{{ section.settings.desc_heading | default: "The Perfumer's Art" }}</span><span class="material-symbols-outlined pdp__acc-icon">expand_more</span></summary>
            <div class="pdp__acc-body pdp__acc-body--rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'product-page.js' | asset_url }}" defer></script>

<style>
  .product-info__wrapper {
    max-width: 640px;
    margin: 0 auto;
  }
  .pdp__accent {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    color: var(--color-gold, #C8A46A);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .pdp__title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-style: italic;
    font-weight: 400;
    font-size: 2.25rem;
    line-height: 1.15;
    color: var(--color-charcoal, #2E2A33);
    margin: 0 0 10px;
  }
  .pdp__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .pdp__price {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-charcoal, #2E2A33);
  }
  .pdp__compare {
    font-size: 0.875rem;
    color: rgba(46,42,51,0.5);
    text-decoration: line-through;
  }
  .pdp__savings {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gold, #C8A46A);
    background: var(--color-gold-10, rgba(200,164,106,0.12));
    padding: 3px 8px;
    border-radius: 2px;
  }

  /* Variants */
  .pdp__variants { margin-bottom: 24px; }
  .pdp__label {
    display: block;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(46,42,51,0.6);
    margin-bottom: 12px;
  }
  .pdp__volume-options { display: flex; gap: 12px; flex-wrap: wrap; }
  .pdp__volume-btn {
    flex: 1 1 0;
    min-width: 90px;
    padding: 12px;
    border: 1px solid rgba(46,42,51,0.12);
    background: transparent;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 12px;
    font-weight: 700;
    color: rgba(46,42,51,0.5);
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.2s ease;
  }
  .pdp__volume-btn.is-active {
    border: 2px solid var(--color-gold, #C8A46A);
    color: var(--color-charcoal, #2E2A33);
  }
  .pdp__volume-btn.is-sold-out { opacity: 0.4; text-decoration: line-through; cursor: not-allowed; }

  /* Actions */
  .pdp__actions { display: flex; flex-direction: column; gap: 16px; }
  .pdp__qty {
    display: flex;
    align-items: center;
    width: 128px;
    height: 48px;
    border: 1px solid rgba(46,42,51,0.12);
    border-radius: 2px;
    overflow: hidden;
  }
  .pdp__qty-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: transparent;
    border: none;
    color: var(--color-charcoal, #2E2A33);
    cursor: pointer;
  }
  .pdp__qty-btn .material-symbols-outlined { font-size: 18px; }
  .pdp__qty-input {
    flex: 1;
    height: 100%;
    text-align: center;
    border: none;
    background: transparent;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-weight: 500;
    color: var(--color-charcoal, #2E2A33);
    -moz-appearance: textfield;
  }
  .pdp__qty-input::-webkit-inner-spin-button,
  .pdp__qty-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  .pdp__btn {
    width: 100%;
    padding: 16px;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .pdp__btn--add {
    background: var(--color-gold, #C8A46A);
    color: #fff;
    box-shadow: 0 10px 20px -8px rgba(200,164,106,0.5);
  }
  .pdp__btn--add:hover { opacity: 0.92; }
  .pdp__btn--add:disabled { opacity: 0.5; cursor: not-allowed; box-shadow: none; }
  .pdp__btn--buy {
    background: var(--color-charcoal, #2E2A33);
    color: #fff;
  }
  .pdp__btn--buy:hover { opacity: 0.9; }

  /* Blocks */
  .pdp__block { margin-top: 48px; }
  .pdp__essence-title,
  .pdp__notes-title { }
  .pdp__essence-title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-charcoal, #2E2A33);
    margin: 0 0 16px;
  }
  .pdp__essence {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(46,42,51,0.8);
    margin: 0;
  }

  /* Attributes */
  .pdp__attrs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 32px 0;
    margin-top: 40px;
    border-top: 1px solid rgba(46,42,51,0.08);
    border-bottom: 1px solid rgba(46,42,51,0.08);
  }
  .pdp__attr { text-align: center; }
  .pdp__attr-label {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(46,42,51,0.4);
    margin: 0 0 4px;
  }
  .pdp__attr-value {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-charcoal, #2E2A33);
    margin: 0;
  }

  /* Notes */
  .pdp__notes-title {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-charcoal, #2E2A33);
    margin: 0 0 24px;
  }
  .pdp__notes { display: flex; flex-direction: column; gap: 24px; }
  .pdp__note { display: flex; align-items: center; gap: 16px; }
  .pdp__note-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    background: var(--color-gold-10, rgba(200,164,106,0.12));
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold, #C8A46A);
  }
  .pdp__note-level {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold, #C8A46A);
    margin: 0 0 2px;
  }
  .pdp__note-value {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 0.875rem;
    color: var(--color-charcoal, #2E2A33);
    margin: 0;
  }

  /* Accordions */
  .pdp__accordions { margin-top: 48px; }
  .pdp__acc { border-top: 1px solid rgba(46,42,51,0.1); }
  .pdp__acc:last-child { border-bottom: 1px solid rgba(46,42,51,0.1); }
  .pdp__acc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-charcoal, #2E2A33);
  }
  .pdp__acc-head::-webkit-details-marker { display: none; }
  .pdp__acc-icon { color: rgba(46,42,51,0.4); transition: transform 0.25s ease; }
  .pdp__acc[open] .pdp__acc-icon { transform: rotate(180deg); }
  .pdp__acc-body {
    padding: 0 0 24px;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(46,42,51,0.75);
  }
  .pdp__acc-body--rte p { margin: 0 0 12px; }

  @media (min-width: 1024px) {
    .pdp__title { font-size: 2.75rem; }
  }
</style>

{% schema %}
{
  "name": "Product Info",
  "settings": [
    {
      "type": "text",
      "id": "accent_text",
      "label": "Accent / collection label",
      "default": "Signature Collection"
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show Buy Now button",
      "default": true
    },
    {
      "type": "header",
      "content": "The Essence"
    },
    {
      "type": "text",
      "id": "essence_heading",
      "label": "Essence heading",
      "default": "The Essence"
    },
    {
      "type": "richtext",
      "id": "essence_default",
      "label": "Essence fallback text",
      "info": "Used when the product has no 'short_description' metafield."
    },
    {
      "type": "header",
      "content": "Attributes (Family / Occasion / Sillage)"
    },
    {
      "type": "text",
      "id": "attr_family_label",
      "label": "Attribute 1 label",
      "default": "Family"
    },
    {
      "type": "text",
      "id": "attr_family",
      "label": "Attribute 1 value",
      "default": "Woody Floral"
    },
    {
      "type": "text",
      "id": "attr_occasion_label",
      "label": "Attribute 2 label",
      "default": "Occasion"
    },
    {
      "type": "text",
      "id": "attr_occasion",
      "label": "Attribute 2 value",
      "default": "Evening"
    },
    {
      "type": "text",
      "id": "attr_sillage_label",
      "label": "Attribute 3 label",
      "default": "Sillage"
    },
    {
      "type": "text",
      "id": "attr_sillage",
      "label": "Attribute 3 value",
      "default": "Moderate"
    },
    {
      "type": "header",
      "content": "Fragrance Notes"
    },
    {
      "type": "text",
      "id": "notes_heading",
      "label": "Notes heading",
      "default": "Fragrance Notes"
    },
    {
      "type": "text",
      "id": "notes_top",
      "label": "Top notes",
      "default": "Bergamot, Saffron, Black Pepper"
    },
    {
      "type": "text",
      "id": "notes_heart",
      "label": "Heart notes",
      "default": "Damask Rose, Iris, Leather"
    },
    {
      "type": "text",
      "id": "notes_base",
      "label": "Base notes",
      "default": "Agarwood (Oud), Amber, Sandalwood"
    },
    {
      "type": "header",
      "content": "Accordions"
    },
    {
      "type": "text",
      "id": "desc_heading",
      "label": "Description accordion heading",
      "default": "The Perfumer's Art"
    },
    {
      "type": "richtext",
      "id": "delivery_text",
      "label": "Delivery & shipping text",
      "default": "<p>2-5 business days across Egypt.</p>"
    },
    {
      "type": "richtext",
      "id": "returns_text",
      "label": "Returns policy text",
      "default": "<p>14-day hassle-free returns.</p>"
    }
  ],
  "presets": [
    {
      "name": "Product Info"
    }
  ]
}
{% endschema %}
