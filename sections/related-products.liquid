<section class="related-products" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="related-products__header">
      <span class="related-products__accent">{{ section.settings.accent_text }}</span>
      <h2 class="related-products__title">{{ 'product.related_products' | t }}</h2>
    </div>

    <div class="scroll-row related-products__row">
      {%- comment -%}
        Simple recommendation algorithm (Liquid):
        Pool = products from the same collection.
        Pass 1: products sharing at least one tag with the current product.
        Pass 2: products from the same brand (vendor).
        Pass 3: fill remaining slots with the rest of the collection.
        shown_ids uses comma delimiters (",id,") to prevent partial-id matches.
      {%- endcomment -%}
      {%- assign max_count = section.settings.products_count | default: 12 -%}
      {%- assign pool = product.collections.first.products -%}
      {%- assign shown = 0 -%}
      {%- assign shown_ids = ',' -%}

      {%- comment -%} Pass 1 — shared tags {%- endcomment -%}
      {%- for rel in pool -%}
        {%- if shown >= max_count -%}{%- break -%}{%- endif -%}
        {%- if rel.id == product.id or rel.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign id_key = ',' | append: rel.id | append: ',' -%}
        {%- unless shown_ids contains id_key -%}
          {%- assign is_match = false -%}
          {%- for t in rel.tags -%}
            {%- if product.tags contains t -%}{%- assign is_match = true -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- if is_match -%}
            <div class="related-products__item">{% render 'product-card', product: rel %}</div>
            {%- assign shown_ids = shown_ids | append: rel.id | append: ',' -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- comment -%} Pass 2 — same brand {%- endcomment -%}
      {%- for rel in pool -%}
        {%- if shown >= max_count -%}{%- break -%}{%- endif -%}
        {%- if rel.id == product.id or rel.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign id_key = ',' | append: rel.id | append: ',' -%}
        {%- unless shown_ids contains id_key -%}
          {%- if rel.vendor == product.vendor -%}
            <div class="related-products__item">{% render 'product-card', product: rel %}</div>
            {%- assign shown_ids = shown_ids | append: rel.id | append: ',' -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- comment -%} Pass 3 — fill remaining from the collection {%- endcomment -%}
      {%- for rel in pool -%}
        {%- if shown >= max_count -%}{%- break -%}{%- endif -%}
        {%- if rel.id == product.id or rel.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign id_key = ',' | append: rel.id | append: ',' -%}
        {%- unless shown_ids contains id_key -%}
          <div class="related-products__item">{% render 'product-card', product: rel %}</div>
          {%- assign shown_ids = shown_ids | append: rel.id | append: ',' -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .related-products {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--color-pearl, #E7DDD4);
    background: var(--color-soft-ivory, #F5F1EB);
  }
  .related-products__header {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .related-products__accent {
    display: block;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-gold, #C8A46A);
    margin-bottom: 4px;
  }
  .related-products__title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 1.35rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-charcoal, #2E2A33);
    margin: 0;
  }
  /* Mobile: compact horizontal scroll */
  .related-products__row {
    gap: 12px;
    padding-bottom: 4px;
  }
  .related-products__item {
    flex: 0 0 130px;
    max-width: 130px;
  }
  @media (min-width: 480px) {
    .related-products__item {
      flex: 0 0 150px;
      max-width: 150px;
    }
  }
  /* Desktop: 4-column grid, items sized by grid not flex */
  @media (min-width: 1024px) {
    .related-products__row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      overflow: visible;
    }
    .related-products__item {
      flex: none;
      max-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "accent_text",
      "label": "Accent text",
      "default": "Discover"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Number of suggested products",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
