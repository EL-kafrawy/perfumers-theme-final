<section class="related-products related-products--pdp" data-section-id="{{ section.id }}">
  <div class="container">
    <h2 class="related-products__title">{{ section.settings.heading | default: 'You May Also Like' }}</h2>

    <div class="related-products__grid">
      {%- comment -%}
        Simple recommendation algorithm (Liquid):
        Pool = products from the same collection.
        Pass 1: products sharing at least one tag with the current product.
        Pass 2: products from the same brand (vendor).
        Pass 3: fill remaining slots with the rest of the collection.
        shown_ids uses comma delimiters (",id,") to prevent partial-id matches.
      {%- endcomment -%}
      {%- assign max_count = section.settings.products_count | default: 4 -%}
      {%- assign pool = product.collections.first.products -%}
      {%- assign shown = 0 -%}
      {%- assign shown_ids = ',' -%}

      {%- comment -%} Pass 1 — shared tags {%- endcomment -%}
      {%- for rel in pool -%}
        {%- if shown >= max_count -%}{%- break -%}{%- endif -%}
        {%- if rel.id == product.id or rel.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign id_key = ',' | append: rel.id | append: ',' -%}
        {%- unless shown_ids contains id_key -%}
          {%- assign is_match = false -%}
          {%- for t in rel.tags -%}
            {%- if product.tags contains t -%}{%- assign is_match = true -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- if is_match -%}
            <div class="related-products__item">{% render 'product-card', product: rel %}</div>
            {%- assign shown_ids = shown_ids | append: rel.id | append: ',' -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- comment -%} Pass 2 — same brand {%- endcomment -%}
      {%- for rel in pool -%}
        {%- if shown >= max_count -%}{%- break -%}{%- endif -%}
        {%- if rel.id == product.id or rel.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign id_key = ',' | append: rel.id | append: ',' -%}
        {%- unless shown_ids contains id_key -%}
          {%- if rel.vendor == product.vendor -%}
            <div class="related-products__item">{% render 'product-card', product: rel %}</div>
            {%- assign shown_ids = shown_ids | append: rel.id | append: ',' -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- comment -%} Pass 3 — fill remaining from the collection {%- endcomment -%}
      {%- for rel in pool -%}
        {%- if shown >= max_count -%}{%- break -%}{%- endif -%}
        {%- if rel.id == product.id or rel.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign id_key = ',' | append: rel.id | append: ',' -%}
        {%- unless shown_ids contains id_key -%}
          <div class="related-products__item">{% render 'product-card', product: rel %}</div>
          {%- assign shown_ids = shown_ids | append: rel.id | append: ',' -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .related-products {
    padding: 3.5rem 0 3rem;
    background: var(--color-soft-ivory, #F5F1EB);
  }
  .related-products__title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-charcoal, #2E2A33);
    margin: 0 0 2rem;
  }
  /* Two-column grid on mobile, wider on desktop */
  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .related-products__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  /* Product-page card treatment: square image + serif italic title */
  .related-products--pdp .product-card__image-wrapper { aspect-ratio: 1 / 1; border-radius: 2px; }
  .related-products--pdp .product-card__title {
    font-style: italic;
    font-size: 1.125rem;
    -webkit-line-clamp: 1;
    min-height: 0;
  }
  .related-products--pdp .product-card__brand { color: rgba(46,42,51,0.5); }
</style>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Number of suggested products",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
