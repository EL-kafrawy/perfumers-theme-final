<style>
  .brand-slider-section {
    background-color: #F5F1EB; /* bg-soft-ivory */
    padding-top: var(--section-pad-y, 2.5rem);
    padding-bottom: var(--section-pad-y, 2.5rem);
    overflow: hidden;
  }
  .brand-slider__heading {
    text-align: center;
    margin-bottom: var(--section-head-gap, 1.5rem);
    padding: 0 1.5rem; /* px-6 */
  }
  .brand-slider__heading h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.25rem; /* text-4xl */
    font-weight: 400;
    font-style: italic;
    color: #2E2A33; /* text-[#2E2A33] */
    letter-spacing: -0.025em; /* tracking-tight */
    margin: 0;
  }

  /* --- Compact mode: a slim switcher strip (used on brand pages) ---
     Keeps the full-size treatment available for the homepage section. */
  .brand-slider-section--compact {
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    border-top: 1px solid rgba(200, 164, 106, 0.18);
    border-bottom: 1px solid rgba(200, 164, 106, 0.18);
  }
  .brand-slider-section--compact .brand-slider__heading {
    margin-bottom: 0.85rem;
  }
  .brand-slider-section--compact .brand-slider__heading h3 {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold, #C8A46A);
  }
  .brand-slider-section--compact .brand-logo-card {
    height: 56px;
    width: 132px;
    padding: 8px 14px;
  }
  .brand-slider-section--compact .brand-slider-track,
  .brand-slider-section--compact .brand-slider-col {
    gap: 1.25rem;
  }
  @media screen and (max-width: 767px) {
    .brand-slider-section--compact .brand-logo-card {
      height: 48px;
      width: 112px;
      padding: 6px 10px;
    }
  }

  /* --- Scroller -----------------------------------------------------
     The wrapper is the scroll container, so a finger drag on mobile is
     plain native scrolling (with momentum) and the autoplay in
     brand-marquee.js drives the very same scrollLeft. One mechanism,
     so the two can't fight. */
  .brand-slider-wrapper {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;          /* Firefox */
    -ms-overflow-style: none;       /* legacy Edge */
    overscroll-behavior-x: contain; /* don't trigger back-swipe */
    /* No touch-action override: the browser decides from the gesture, so a
       vertical swipe starting on the strip still scrolls the page. */
  }
  .brand-slider-wrapper::-webkit-scrollbar {
    display: none;
  }
  /* Only advertise grabbing once JS is actually driving it. */
  .brand-slider-wrapper.is-interactive {
    cursor: grab;
  }
  .brand-slider-wrapper.is-dragging {
    cursor: grabbing;
  }
  .brand-slider-wrapper.is-dragging .brand-logo-card {
    /* Suppress hover lift while dragging so logos don't twitch. */
    transform: none;
  }
  .brand-slider-track {
    display: flex;
    gap: 2rem; /* gap-8 */
    width: max-content;
    white-space: nowrap;
  }
  .brand-slider-col {
    display: flex;
    align-items: center;
    gap: 2rem; /* gap-8 */
    padding: 0 1rem; /* px-4 */
  }
  /* Fixed "lockup" box: every brand gets an identical rectangle — same width
     AND same height — and the artwork is fitted inside it. Previously only the
     height was capped while width ran free, so a wide wordmark and a square
     badge ended up occupying very different amounts of the strip. */
  .brand-logo-card {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    /* Driven by the section settings via custom properties on the section,
       so the box can be resized in the editor without touching CSS. A block
       may override either axis for one specific logo. */
    height: var(--card-h, 100px);
    width: var(--card-w, 208px);
    padding: 12px 20px;
    background-color: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    transition: opacity 0.3s ease, transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  @media screen and (max-width: 767px) {
    .brand-logo-card {
      height: var(--card-h-mob, 76px);
      width: var(--card-w-mob, 156px);
      padding: 10px 14px;
    }
  }

  /* Text fallback for brands with no logo, sized to sit level with real logos */
  .brand-logo-card__text {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #2D2926;
    text-align: center;
    line-height: 1.15;
    white-space: nowrap;
  }
  .brand-slider-section--compact .brand-logo-card__text {
    font-size: 9px;
    letter-spacing: 0.05em;
  }
  .brand-logo-card:hover {
    transform: scale(1.05); /* hover:scale-105 */
  }
  .brand-logo-card img {
    /* Fill the shared box and let object-fit letterbox the artwork inside it,
       so the size is enforced on the image itself rather than left to each
       logo's own aspect ratio. --logo-scale stays available as a per-brand
       nudge for logos carrying a lot of built-in whitespace; at the default
       of 100% every logo is sized identically. */
    width: 100%;
    height: 100%;
    /* contain = whole logo, letterboxed (never distorted).
       cover   = fills the box edge to edge, cropping overflow.
       Chosen per section in the editor. */
    object-fit: var(--logo-fit, contain);
    object-position: center;
    transform: scale(var(--logo-scale, 1));
    pointer-events: none;
    user-select: none;
  }

  /* Accessibility: prefers-reduced-motion fallback.
     Autoplay is disabled in JS; the strip stays manually scrollable. */
  @media (prefers-reduced-motion: reduce) {
    .brand-logo-card {
      transition: none;
    }
  }
</style>

{%- comment -%}
  Box size lives on the section as custom properties so every logo inherits the
  same rectangle — that is what makes them all render at one size regardless of
  the source artwork's own aspect ratio.
{%- endcomment -%}
<section class="brand-slider-section{% if section.settings.compact %} brand-slider-section--compact{% endif %}"
         id="brandSliderSection"
         style="
           --card-w: {{ section.settings.logo_width | default: 208 }}px;
           --card-h: {{ section.settings.logo_height | default: 100 }}px;
           --card-w-mob: {{ section.settings.logo_width_mobile | default: 156 }}px;
           --card-h-mob: {{ section.settings.logo_height_mobile | default: 76 }}px;
           --logo-fit: {{ section.settings.logo_fit | default: 'contain' }};
         ">
  {%- if section.settings.heading != blank -%}
    <div class="brand-slider__heading">
      <h3>{{ section.settings.heading }}</h3>
    </div>
  {%- endif -%}
  <div class="brand-slider-wrapper"
       data-brand-marquee
       data-speed="{{ section.settings.scroll_speed | default: 30 }}"
       data-autoplay="{% if section.settings.autoplay == false %}false{% else %}true{% endif %}"
       tabindex="0"
       role="region"
       aria-label="{{ section.settings.heading | default: 'Shop by Brand' | escape }}">
    {%- comment -%}
      Dynamic brands: any collection flagged with the boolean metafield
      custom.is_brand renders automatically here. Logo = custom.brand_logo
      (file/image metafield) if set, otherwise the collection's image.
      Falls back to manually-added logo blocks when no collections are flagged.
    {%- endcomment -%}
    {%- assign has_brands = false -%}
    {%- for collection in collections -%}
      {%- if collection.metafields.custom.is_brand.value -%}{%- assign has_brands = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    <div class="brand-slider-track" id="brandSliderTrack" data-brand-marquee-track>
      {%- for i in (1..2) -%}
        {%- assign is_clone = false -%}
        {%- if i == 2 -%}{%- assign is_clone = true -%}{%- endif -%}
        <div class="brand-slider-col">
          {%- if has_brands -%}
            {%- for collection in collections -%}
              {%- unless collection.metafields.custom.is_brand.value -%}{%- continue -%}{%- endunless -%}
              {%- assign brand_logo = collection.metafields.custom.brand_logo.value | default: collection.image -%}
              <a href="{{ collection.url }}"
                 class="brand-logo-card"
                 {% if is_clone %}aria-hidden="true" tabindex="-1"{% endif %}>
                {%- if brand_logo != blank -%}
                  <img src="{{ brand_logo | image_url: width: 400 }}" alt="{{ collection.title | escape }}" loading="lazy" draggable="false">
                {%- else -%}
                  <span class="brand-logo-card__text">{{ collection.title }}</span>
                {%- endif -%}
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- assign brand_link = block.settings.link -%}
              {%- if brand_link == blank or brand_link == '#' -%}
                {%- assign brand_link = routes.all_products_collection_url -%}
              {%- endif -%}
              {%- assign logo_scale = block.settings.logo_scale | default: 100 | divided_by: 100.0 -%}
              {%- comment -%}
                Per-logo overrides. 0 means "inherit the section box", which is
                how a range setting expresses "unset" — so by default every
                logo stays exactly the same size as its neighbours.
              {%- endcomment -%}
              {%- capture card_style -%}
                --logo-scale: {{ logo_scale }};
                {%- if block.settings.width_override > 0 %} --card-w: {{ block.settings.width_override }}px; --card-w-mob: {{ block.settings.width_override }}px;{% endif -%}
                {%- if block.settings.height_override > 0 %} --card-h: {{ block.settings.height_override }}px; --card-h-mob: {{ block.settings.height_override }}px;{% endif -%}
                {%- if block.settings.fit_override != 'inherit' and block.settings.fit_override != blank %} --logo-fit: {{ block.settings.fit_override }};{% endif -%}
              {%- endcapture -%}
              <a href="{{ brand_link }}"
                 class="brand-logo-card"
                 style="{{ card_style | strip_newlines | strip }}"
                 {% if is_clone %}aria-hidden="true" tabindex="-1"{% endif %}
                 {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  <img src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ block.settings.brand_name | escape }}" loading="lazy" draggable="false">
                {%- elsif block.settings.logo_url != blank -%}
                  <img src="{{ block.settings.logo_url }}" alt="{{ block.settings.brand_name | escape }}" loading="lazy" draggable="false">
                {%- elsif block.settings.logo_file != blank -%}
                  <img src="{{ block.settings.logo_file | asset_url }}" alt="{{ block.settings.brand_name | escape }}" loading="lazy" draggable="false">
                {%- else -%}
                  <span class="brand-logo-card__text">{{ block.settings.brand_name }}</span>
                {%- endif -%}
              </a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  The strip is rendered twice above (Liquid duplication) so the scroller can
  wrap seamlessly at one copy's width. brand-marquee.js drives the autoplay
  and the drag-to-scroll.
{%- endcomment -%}
<script src="{{ 'brand-marquee.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Brand Logo Slider",
  "settings": [
    {
      "type": "paragraph",
      "content": "Brands are automatic: any Collection with the boolean metafield 'custom.is_brand' = true appears here, using its 'custom.brand_logo' image (or the collection image) and linking to its collection page. The manual blocks below are only used when no collections are flagged."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "info": "Leave empty to hide the heading entirely.",
      "default": "Shop by Brand"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Compact strip",
      "info": "Slim version with a small label and tighter spacing. Use on brand pages so the switcher takes minimal vertical space.",
      "default": false
    },
    {
      "type": "header",
      "content": "Movement"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-scroll (showcase mode)",
      "info": "The strip glides on its own to show off the brands. Dragging and swiping keep working either way — turn this off to make it a purely manual menu.",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "label": "Seconds per loop",
      "info": "Lower is faster. Only affects the idle auto-scroll.",
      "default": 30
    },
    {
      "type": "header",
      "content": "Logo size"
    },
    {
      "type": "paragraph",
      "content": "Every logo is drawn inside an identical box, which is what makes them all appear the same size no matter what shape the original file is. Change the box here and all logos follow."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Logo width (desktop)",
      "default": 208
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Logo width (mobile)",
      "default": 156
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 32,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Logo height (mobile)",
      "default": 76
    },
    {
      "type": "select",
      "id": "logo_fit",
      "label": "How logos fill the box",
      "info": "Fit whole logo keeps every logo undistorted (recommended). Fill box crops the edges to fill the rectangle completely.",
      "options": [
        { "value": "contain", "label": "Fit whole logo (no cropping)" },
        { "value": "cover", "label": "Fill box (crops edges)" }
      ],
      "default": "contain"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image (uploaded to Shopify Files)"
        },
        {
          "type": "text",
          "id": "logo_url",
          "label": "Logo image URL (Stitch mockups)"
        },
        {
          "type": "text",
          "id": "logo_file",
          "label": "Logo filename (in theme assets)",
          "info": "e.g. brand-logo-dkhoon.jpg"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection link"
        },
        {
          "type": "range",
          "id": "logo_scale",
          "min": 60,
          "max": 130,
          "step": 5,
          "unit": "%",
          "label": "Logo scale",
          "info": "Nudge this logo up or down so it looks balanced next to the others. The box stays the same size.",
          "default": 100
        },
        {
          "type": "header",
          "content": "Override size for this logo only"
        },
        {
          "type": "paragraph",
          "content": "Leave these at 0 to keep this logo the same size as every other one. Only change them if a single brand's artwork needs a different box."
        },
        {
          "type": "range",
          "id": "width_override",
          "min": 0,
          "max": 320,
          "step": 4,
          "unit": "px",
          "label": "Width",
          "info": "0 = use the section width.",
          "default": 0
        },
        {
          "type": "range",
          "id": "height_override",
          "min": 0,
          "max": 180,
          "step": 4,
          "unit": "px",
          "label": "Height",
          "info": "0 = use the section height.",
          "default": 0
        },
        {
          "type": "select",
          "id": "fit_override",
          "label": "How this logo fills its box",
          "options": [
            { "value": "inherit", "label": "Same as section" },
            { "value": "contain", "label": "Fit whole logo (no cropping)" },
            { "value": "cover", "label": "Fill box (crops edges)" }
          ],
          "default": "inherit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Marquee",
      "blocks": [
        { "type": "logo", "settings": { "brand_name": "Dkhoon", "logo_file": "brand-logo-dkhoon.jpg" } },
        { "type": "logo", "settings": { "brand_name": "Afnan", "logo_file": "brand-logo-afnan.jpg" } },
        { "type": "logo", "settings": { "brand_name": "Assaf", "logo_file": "brand-logo-assaf.png" } },
        { "type": "logo", "settings": { "brand_name": "Lattafa", "logo_file": "brand-logo-lattafa.png" } },
        { "type": "logo", "settings": { "brand_name": "French Avenue", "logo_file": "brand-logo-french-avenue.jpg" } },
        { "type": "logo", "settings": { "brand_name": "IBRAQ", "logo_file": "brand-logo-ibraq.jpg" } },
        { "type": "logo", "settings": { "brand_name": "Rasasi", "logo_file": "brand-logo-rasasi.webp" } }
      ]
    }
  ]
}
{% endschema %}
